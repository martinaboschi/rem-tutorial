timing <- unique(all_results[c("run_num", "p", "n_replicates", "n_sampled",
"est_time", "naive_time",
"ac_time", "simex_time")])
timing$total_naive_pipeline <- timing$est_time + timing$naive_time
timing$total_simex_pipeline <- timing$est_time + timing$naive_time +
timing$simex_time
cat("\n=== mean computational time (sec) per outer replicate, by p ===\n")
timing_summary <- aggregate(
cbind(est_time, naive_time, ac_time, simex_time,
total_naive_pipeline, total_simex_pipeline) ~ p + n_replicates,
data = timing, FUN = mean
)
print(timing_summary, digits = 4)
cat("\n=== speed ratio: (row-subsampling) time / (p = 1, complete) time ===\n")
t_p1 <- timing_summary$total_naive_pipeline[timing_summary$p == 1]
timing_summary$ratio_vs_full_naive <- timing_summary$total_naive_pipeline / t_p1
timing_summary$ratio_vs_full_simex <- timing_summary$total_simex_pipeline / t_p1
print(timing_summary[c("p", "total_naive_pipeline", "total_simex_pipeline",
"ratio_vs_full_naive", "ratio_vs_full_simex")],
digits = 4)
method_cols <- c(naive                     = "grey80",
ac_closed                 = "steelblue",
simex_closed              = "goldenrod",
simex_quadratic_closed    = "darkorange3",
ac_empirical              = "darkseagreen",
simex_empirical           = "indianred",
simex_quadratic_empirical = "firebrick")
term_labels <- c(est_rec = "reciprocity", est_rep = "repetition",
est_cyc = "cyclicity",   est_tra = "transitivity")
# One covariate (`trm`): for each value of `by` (a column of `data`, e.g.
# "p" or "n_replicates") the methods side by side, plus the true value as a
# dashed red line and zero as a dashed grey line. type = "ci" (default): median of the estimates across
# fits (dot) and the interval holding their central `level` share (2.5% to
# 97.5% for level = 0.95); the y-axis follows the intervals, so fits outside
# them are not shown. type = "box": boxplots with every value, outliers
# included. Methods whose column is entirely NA in this slice (e.g.
# *_empirical at n_replicates = 0) are dropped. Only draws: open/close the
# device in the caller.
plot_methods_by <- function(data, trm, by, true_value,
methods = names(method_cols), main = NULL,
type = c("ci", "box"), level = 0.95) {
type    <- match.arg(type)
if (!by %in% names(data)) stop(sprintf("plot_methods_by(): `data` has no column '%s'", by))
sub     <- data[data$term == trm, ]
if (nrow(sub) == 0) stop(sprintf("plot_methods_by(): no rows for term '%s'", trm))
methods <- methods[methods %in% names(sub)]
methods <- methods[sapply(methods, function(m) any(!is.na(sub[[m]])))]
levs    <- sort(unique(sub[[by]]))
ng <- length(levs); nm <- length(methods)
vals <- list(); at <- numeric(0)
for (g in seq_len(ng)) for (k in seq_len(nm)) {
x <- sub[[methods[k]]][sub[[by]] == levs[g]]
vals[[length(vals) + 1]] <- x[!is.na(x)]
at <- c(at, (g - 1) * (nm + 1) + k)
}
if (is.null(main)) main <- if (trm %in% names(term_labels)) term_labels[[trm]] else trm
cols <- rep(method_cols[methods], ng)
xlim <- c(0.5, ng * (nm + 1) - 0.5)
if (type == "box") {
boxplot(vals, at = at, col = cols, xaxt = "n", xlim = xlim,
ylim = range(c(unlist(vals), true_value, 0), na.rm = TRUE),
main = main, xlab = by, ylab = "beta", outcex = 0.5)
} else {
q   <- (1 - level) / 2
qs  <- sapply(vals, function(x) if (length(x)) quantile(x, c(q, 0.5, 1 - q), names = FALSE)
else rep(NA_real_, 3))
ylim <- range(c(qs, true_value, 0), na.rm = TRUE)
ylim[2] <- ylim[2] + 0.35 * diff(ylim)   # room for the legend above the intervals
plot(NA, xlim = xlim, ylim = ylim, xaxt = "n",
main = main, xlab = by, ylab = sprintf("beta (median, central %g%% of fits)", 100 * level))
segments(at, qs[1, ], at, qs[3, ], col = cols, lwd = 3)
points(at, qs[2, ], pch = 21, bg = cols, cex = 1.2)
}
axis(1, at = (seq_len(ng) - 1) * (nm + 1) + (nm + 1) / 2, labels = levs)
abline(h = 0, col = "grey40", lwd = 1, lty = 2)
abline(h = true_value, col = "red", lwd = 1.5, lty = 2)
legend("topright", legend = c(methods, "true value", "zero"),
fill = c(method_cols[methods], NA, NA), border = c(rep("black", nm), NA, NA),
lty = c(rep(NA, nm), 2, 2), col = c(rep(NA, nm), "red", "grey40"),
bty = "n", cex = 0.65)
}
