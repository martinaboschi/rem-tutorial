remdat <- readRDS("~/Dropbox/Martina/PhD/07-Sampling-Covariates/01-Code/errors_in_variables_rems/s1-theoretical-properties/experiment_row_subsampling_decay_remdat_check.rds")
hist(remdat$delta_reciprocity)
hist(remdat$delta_repetition)
hist(remdat$delta_cyclicity)
sum(remdat$delta_reciprocity == 0)
sum(remdat$delta_repetition == 0)
sum(remdat$delta_cyclicity == 0)
true_fit  <- glm(one ~ delta_reciprocity + delta_repetition + delta_cyclicity - 1,
family = "binomial", data = remdat)
beta_true <- setNames(coef(true_fit), c("est_rec", "est_rep", "est_cyc"))
cat("true model estimate (full network):\n"); print(beta_true)
summary(true_fit)
true_betas <- c(est_rec = b1, est_rep = b2, est_cyc = b4)   # simulation ground truth
dat <- as.matrix(remdat[c("tms", "s", "r")])
results_by_p <- list()
reps_by_p    <- list()
for (n_replicates in n_replicates_values) for (p in p_values) {
key <- sprintf("p=%s_nrep=%d", p, n_replicates)
cat(sprintf("\n\n====================================================\n"))
cat(sprintf("  p = %.2f, n_replicates = %d (decay_rec = %.1f, decay_rep = %.1f, decay_cyc = %.1f)\n",
p, n_replicates, decay_rec, decay_rep, decay_cyc))
cat(sprintf("====================================================\n"))
draws <- vector("list", n_estimates)
p_rows <- lapply(seq_len(n_estimates), function(run_num) {
t0   <- Sys.time()
draw <- row_subsample_hybrid(remdat, dat, p = p,
n_replicates = n_replicates,
seed = 1000 * run_num,
decay_rec = decay_rec,
decay_rep = decay_rep,
decay_tra = decay_tra,
decay_cyc = decay_cyc,
est_d_cov_names = d_names,
est_tr_cov_names = tr_names,
n_act = n_act, verbose = TRUE)
draws[[run_num]] <<- draw
res <- fit_one_replicate_hybrid(draw, remdat, simex_B, simex_lambda)
cat("  fit", run_num, "/", n_estimates, "--",
round(as.numeric(Sys.time() - t0, units = "secs"), 1), "sec\n")
res$est_time <- attr(draw, "est_time")
cbind(run_num = run_num, res)
})
reps_by_p[[key]] <- draws
p_df   <- do.call(rbind, p_rows)
p_df$p <- p
p_df$n_replicates <- n_replicates
results_by_p[[key]] <- p_df
cat(sprintf("\n  p = %.2f, n_replicates = %d done.\n", p, n_replicates))
}
cat("\n\n====================================================\n")
cat("  p = 1 (complete data, no replication/variance)\n")
cat("====================================================\n")
t0 <- Sys.time()
main_p1 <- row_subsample_replicate(remdat, dat, p = 1, seed_i = 1,
decay_rec = decay_rec, decay_rep = decay_rep,
decay_tra = decay_tra, decay_cyc = decay_cyc,
want_rec = TRUE, want_rep = TRUE,
want_tra = FALSE, want_cyc = TRUE,
n_act = n_act)
est_time_p1 <- as.numeric(Sys.time() - t0, units = "secs")
ids_p1 <- main_p1$id
eval_data_p1 <- remdat[ids_p1, "one", drop = FALSE]
eval_data_p1$est_rec <- main_p1$est_rec
eval_data_p1$est_rep <- main_p1$est_rep
eval_data_p1$est_cyc <- main_p1$est_cyc
reps_by_p[["p=1"]] <- list(main_p1)
t0     <- Sys.time()
fit_p1 <- glm(one ~ est_rec + est_rep + est_cyc - 1, family = "binomial",
data = eval_data_p1)
glm_time_p1 <- as.numeric(Sys.time() - t0, units = "secs")
beta_p1 <- coef(fit_p1)
p1_df <- data.frame(run_num = 1, term = names(beta_p1),
naive = as.numeric(beta_p1),
ac_closed = as.numeric(beta_p1),
simex_closed = as.numeric(beta_p1),
simex_quadratic_closed = as.numeric(beta_p1),
ac_empirical = as.numeric(beta_p1),
simex_empirical = as.numeric(beta_p1),
simex_quadratic_empirical = as.numeric(beta_p1),
n_sampled = length(ids_p1), p = 1, n_replicates = 0,
naive_time = glm_time_p1, ac_time = 0, simex_time = 0,
simex_quadratic_time = 0,
est_time = est_time_p1)
all_results <- rbind(do.call(rbind, results_by_p), p1_df)
rownames(all_results) <- NULL
saveRDS(all_results,
file.path(out_dir,
"experiment_row_subsampling_decay_check.rds"))
