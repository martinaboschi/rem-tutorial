"experiment_row_subsampling_decay_check.rds"))
## Checkpoint: everything the plots need, so the plotting block at the
## bottom can be rerun after load()-ing this instead of re-simulating.
save(all_results, beta_true, true_betas, reps_by_p, p_values,
n_replicates_values, M, out_dir,
file = file.path(out_dir, "experiment_row_subsampling_decay_for_plotting_check.RData"))
cat("\n=== mean beta across runs, by term and p ===\n")
summary_mean <- aggregate(cbind(naive, ac_closed, simex_quadratic_closed, simex_closed) ~ term + p + n_replicates,
data = all_results,
FUN = function(x) mean(x, na.rm = TRUE))
print(summary_mean, digits = 4)
cat("\n=== median beta across runs, by term and p ===\n")
summary_median <- aggregate(cbind(naive, ac_closed, simex_quadratic_closed, simex_closed) ~ term + p + n_replicates,
data = all_results,
FUN = function(x) median(x, na.rm = TRUE))
print(summary_median, digits = 4)
cat("\n=== mean sampled subnetwork size, by p ===\n")
