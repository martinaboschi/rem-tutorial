envs <- list(
E1 = gen_data(n = n, case = "fork", pz = 0.2),
E2 = gen_data(n = n, case = "fork", pz = 0.8)
)
}
if (case == "chain") {
envs <- list(
E1 = gen_data(n = n, case = "chain", px = 0.2, gamma_y = log(6)),
E2 = gen_data(n = n, case = "chain", px = 0.8, gamma_y = log(14))
)
}
out <- lapply(names(envs), function(nm) {
dat <- envs[[nm]]
fits <- fit_models(dat)
data.frame(
env = nm,
logit_Y_X_Xcoef = coef(fits$logit_x)["X"],
logit_Y_XZ_Xcoef = coef(fits$logit_xz)["X"],
logit_Y_XZ_Zcoef = coef(fits$logit_xz)["Z"],
PY_X0 = mean(dat$Y[dat$X == 0]),
PY_X1 = mean(dat$Y[dat$X == 1])
)
})
do.call(rbind, out)
}
# =========================================================
# 9) PLOTTING
# =========================================================
plot_case <- function(dat, fits, main_prefix = "") {
op <- par(mfrow = c(2, 3), mar = c(4, 4, 3, 1))
# observed cell means
py_x  <- aggregate(Y ~ X, data = dat, mean)
py_z  <- aggregate(Y ~ Z, data = dat, mean)
py_xz <- aggregate(Y ~ X + Z, data = dat, mean)
# fitted predictions
gx <- data.frame(X = c(0,1))
gx$pred <- predict(fits$logit_x, newdata = gx, type = "response")
gz <- data.frame(Z = c(0,1))
gz$pred <- predict(fits$logit_z, newdata = gz, type = "response")
gxz <- expand.grid(X = c(0,1), Z = c(0,1))
gxz$pred <- predict(fits$logit_xz, newdata = gxz, type = "response")
yl <- range(c(py_x$Y, py_z$Y, py_xz$Y, gx$pred, gz$pred, gxz$pred))
# observed Y|X
plot(py_x$X, py_x$Y, type = "b", pch = 19, xaxt = "n",
ylim = yl, xlab = "X", ylab = "P(Y=1)",
main = paste(main_prefix, "Observed: Y | X"))
axis(1, at = c(0,1), labels = c("0","1"))
# observed Y|Z
plot(py_z$Z, py_z$Y, type = "b", pch = 19, xaxt = "n",
ylim = yl, xlab = "Z", ylab = "P(Y=1)",
main = paste(main_prefix, "Observed: Y | Z"))
axis(1, at = c(0,1), labels = c("0","1"))
# observed Y|X,Z
mat_obs <- matrix(py_xz$Y[order(py_xz$Z, py_xz$X)], nrow = 2, byrow = TRUE)
matplot(c(0,1), t(mat_obs), type = "b", pch = 19, lty = 1, xaxt = "n",
ylim = yl, xlab = "X", ylab = "P(Y=1)",
main = paste(main_prefix, "Observed: Y | X,Z"))
axis(1, at = c(0,1), labels = c("0","1"))
legend("topleft", legend = c("Z=0","Z=1"), pch = 19, lty = 1, bty = "n")
# fitted Y~X
plot(gx$X, gx$pred, type = "b", pch = 19, xaxt = "n",
ylim = yl, xlab = "X", ylab = "Pred P(Y=1)",
main = paste(main_prefix, "Logit fit: Y ~ X"))
axis(1, at = c(0,1), labels = c("0","1"))
# fitted Y~Z
plot(gz$Z, gz$pred, type = "b", pch = 19, xaxt = "n",
ylim = yl, xlab = "Z", ylab = "Pred P(Y=1)",
main = paste(main_prefix, "Logit fit: Y ~ Z"))
axis(1, at = c(0,1), labels = c("0","1"))
# fitted Y~X+Z
mat_fit <- matrix(gxz$pred[order(gxz$Z, gxz$X)], nrow = 2, byrow = TRUE)
matplot(c(0,1), t(mat_fit), type = "b", pch = 19, lty = 1, xaxt = "n",
ylim = yl, xlab = "X", ylab = "Pred P(Y=1)",
main = paste(main_prefix, "Logit fit: Y ~ X + Z"))
axis(1, at = c(0,1), labels = c("0","1"))
legend("topleft", legend = c("Z=0","Z=1"), pch = 19, lty = 1, bty = "n")
par(op)
}
# =========================================================
# 10) ONE WRAPPER TO RUN EVERYTHING
# =========================================================
analyze_case <- function(case = c("fork", "chain"),
n = 200000,
px = 0.5,
pz = 0.5) {
case <- match.arg(case)
dat  <- gen_data(n = n, case = case, px = px, pz = pz)
fits <- fit_models(dat)
cat("\n\n####################################################\n")
cat("CASE:", toupper(case), "\n")
cat("####################################################\n")
cat("\nObserved conditional means:\n")
cp <- cond_prob_Y(dat)
print(cp$Y_given_X)
print(cp$Y_given_Z)
print(cp$Y_given_XZ)
check_independence(dat, case_name = case)
coef_table(fits, case_name = case)
cat("\nObserved association of Y with X:\n")
print(observed_associations(dat))
cat("\nModel-based g-formula estimates of P(Y=1 | do(X=x)):\n")
print(estimate_do_from_models(dat, fits))
cat("\nTrue interventional quantities:\n")
truth <- data.frame(
do_x0 = true_do_prob(case, x_val = 0, pz = pz),
do_x1 = true_do_prob(case, x_val = 1, pz = pz),
do_RD = do_risk_difference(case, pz = pz),
do_RR = do_risk_ratio(case, pz = pz),
do_OR = do_odds_ratio(case, pz = pz)
)
print(truth)
plot_case(dat, fits, main_prefix = paste0(toupper(substr(case,1,1)), substr(case,2,nchar(case)), ":"))
invisible(list(dat = dat, fits = fits))
}
fork_res  <- analyze_case("fork")
cat("\n\n====================================================\n")
cat("Environment shifts: FORK\n")
cat("====================================================\n")
fork_env <- run_environments("fork")
print(fork_env)
# ============================================================================
# QUICK DEMO: Four Causal Concepts in Linear vs Logistic Regression
# ============================================================================
set.seed(42)
# Generate large sample for clear results
n <- 100000
# Causal structure: X ⊥ Z (independent), both affect Y
Z <- rbinom(n, 1, 0.5)
X <- rbinom(n, 1, 0.5)
# Verify independence
cat("=== Verifying X ⊥ Z ===\n")
cat("P(X=1|Z=0):", mean(X[Z==0]), "\n")
cat("P(X=1|Z=1):", mean(X[Z==1]), "\n")
cat("Independence test p-value:", chisq.test(table(X,Z))$p.value, "\n\n")
# ============================================================================
# LINEAR MODEL: Y = 2X + 3Z + noise
# ============================================================================
Y_linear <- 2*X + 3*Z + rnorm(n, 0, 1)
cat("==================== LINEAR MODEL ====================\n\n")
# Models
lm_full <- lm(Y_linear ~ X + Z)
lm_marg <- lm(Y_linear ~ X)
# Extract coefficients
beta_full <- coef(lm_full)["X"]
beta_marg <- coef(lm_marg)["X"]
cat("1. COLLAPSIBILITY:\n")
cat(sprintf("   Conditional β (with Z): %.4f\n", beta_full))
cat(sprintf("   Marginal β (without Z): %.4f\n", beta_marg))
cat(sprintf("   Difference: %.6f ✓\n\n", abs(beta_full - beta_marg)))
# Simulate intervention
set.seed(123)
Z_int <- rbinom(10000, 1, 0.5)
causal_effect <- mean(2*1 + 3*Z_int) - mean(2*0 + 3*Z_int)
cat("2. CAUSAL INVARIANCE:\n")
cat(sprintf("   E[Y|do(X=1)] - E[Y|do(X=0)]: %.4f\n", causal_effect))
cat(sprintf("   Conditional β: %.4f\n", beta_full))
cat(sprintf("   Marginal β: %.4f\n", beta_marg))
cat("   → All three are equal! ✓\n\n")
Y_logistic <- rbinom(n, 1, plogis(2*X + 3*Z))
cat("==================== LOGISTIC MODEL ====================\n\n")
# Models
glm_full <- glm(Y_logistic ~ X + Z, family = binomial)
glm_marg <- glm(Y_logistic ~ X, family = binomial)
# Extract coefficients
beta_full_log <- coef(glm_full)["X"]
beta_marg_log <- coef(glm_marg)["X"]
cat("1. NON-COLLAPSIBILITY:\n")
cat(sprintf("   Conditional β (with Z): %.4f\n", beta_full_log))
cat(sprintf("   Marginal β (without Z): %.4f\n", beta_marg_log))
cat(sprintf("   Difference: %.4f ✗\n\n", abs(beta_full_log - beta_marg_log)))
# Simulate intervention
set.seed(456)
Z_int <- rbinom(10000, 1, 0.5)
P_Y_doX1 <- mean(rbinom(10000, 1, plogis(2*1 + 3*Z_int)))
P_Y_doX0 <- mean(rbinom(10000, 1, plogis(2*0 + 3*Z_int)))
causal_logodds <- log(P_Y_doX1/(1-P_Y_doX1)) - log(P_Y_doX0/(1-P_Y_doX0))
cat("2. CAUSAL NON-INVARIANCE:\n")
cat(sprintf("   Causal log-odds ratio: %.4f\n", causal_logodds))
cat(sprintf("   Conditional β: %.4f\n", beta_full_log))
cat(sprintf("   Marginal β: %.4f\n", beta_marg_log))
cat("   → All three are DIFFERENT! ✗\n\n")
set.seed(42)
library(ggplot2)
n <- 100000  # Large sample for numerical stability
# Background factor (e.g., disease severity, baseline risk)
Z <- rbinom(n, 1, 0.5)
# Treatment/exposure (independent of Z by design - no confounding)
X <- rbinom(n, 1, 0.5)
# Verify independence
cat("=== Verifying X ⊥ Z (No Confounding) ===\n")
cat(sprintf("P(X=1|Z=0) = %.4f\n", mean(X[Z==0])))
cat(sprintf("P(X=1|Z=1) = %.4f\n", mean(X[Z==1])))
cat(sprintf("P(X=1) = %.4f\n", mean(X)))
independence_test <- chisq.test(table(X, Z))
cat(sprintf("Chi-square test p-value: %.4f\n", independence_test$p.value))
cat("✓ X and Z are independent (no confounding)\n\n")
# Causal mechanism for Y
# Y = 2*X + 3*Z + noise
Y_linear <- 2*X + 3*Z + rnorm(n, 0, 1)
# Downstream consequence W (e.g., quality of life, complications)
# W depends on Y
W_linear <- 0.5*Y_linear + rnorm(n, 0, 0.5)
# Full model (complete causes of Y)
lm_full <- lm(Y_linear ~ X + Z)
beta_X_full <- coef(lm_full)["X"]
# Partial model (omitting Z)
lm_partial <- lm(Y_linear ~ X)
beta_X_partial <- coef(lm_partial)["X"]
cat("FULL model E[Y|X,Z]:\n")
cat(sprintf("  β_X = %.4f (effect of X given Z)\n", beta_X_full))
cat("\nPARTIAL model E[Y|X]:\n")
cat(sprintf("  β_X = %.4f (marginal effect of X)\n", beta_X_partial))
cat(sprintf("\nDifference: %.6f\n", abs(beta_X_full - beta_X_partial)))
cat("✓ COLLAPSIBLE: Effect is the same!\n")
cat("  Why? Linearity + X⊥Z → effect doesn't depend on Z's distribution\n\n")
# True marginal E[Y|X] from data
marginal_Y_X0 <- mean(Y_linear[X == 0])
marginal_Y_X1 <- mean(Y_linear[X == 1])
# Predicted from marginal model
pred_Y_X0 <- predict(lm_partial, newdata = data.frame(X = 0))
pred_Y_X1 <- predict(lm_partial, newdata = data.frame(X = 1))
cat("True marginal E[Y|X=0]:", marginal_Y_X0, "\n")
cat("Fitted linear model E[Y|X=0]:", pred_Y_X0, "\n")
cat("Error:", abs(marginal_Y_X0 - pred_Y_X0), "\n\n")
cat("True marginal E[Y|X=1]:", marginal_Y_X1, "\n")
cat("Fitted linear model E[Y|X=1]:", pred_Y_X1, "\n")
cat("Error:", abs(marginal_Y_X1 - pred_Y_X1), "\n\n")
cat("✓ CLOSED: Marginal relationship is still perfectly linear\n")
cat("  The linear family is preserved under marginalization\n\n")
set.seed(123)
n_sim <- 10000
# do(X=1, Z=1)
Y_do_X1_Z1_linear <- 2*1 + 3*1 + rnorm(n_sim, 0, 1)
E_Y_do_X1_Z1 <- mean(Y_do_X1_Z1_linear)
# do(X=0, Z=1)
Y_do_X0_Z1_linear <- 2*0 + 3*1 + rnorm(n_sim, 0, 1)
E_Y_do_X0_Z1 <- mean(Y_do_X0_Z1_linear)
complete_effect <- E_Y_do_X1_Z1 - E_Y_do_X0_Z1
cat(sprintf("E[Y|do(X=1, Z=1)] = %.4f\n", E_Y_do_X1_Z1))
cat(sprintf("E[Y|do(X=0, Z=1)] = %.4f\n", E_Y_do_X0_Z1))
cat(sprintf("COMPLETE intervention effect = %.4f\n\n", complete_effect))
# Type 2: PARTIAL intervention - do(X=x)
cat("--- Type 2: PARTIAL Intervention do(X) ---\n")
cat("We intervene on X only; Z varies naturally\n\n")
# do(X=1): Set X=1, let Z vary
Z_natural <- rbinom(n_sim, 1, 0.5)
Y_do_X1_linear <- 2*1 + 3*Z_natural + rnorm(n_sim, 0, 1)
E_Y_do_X1 <- mean(Y_do_X1_linear)
# do(X=0): Set X=0, let Z vary
Z_natural <- rbinom(n_sim, 1, 0.5)
Y_do_X0_linear <- 2*0 + 3*Z_natural + rnorm(n_sim, 0, 1)
E_Y_do_X0 <- mean(Y_do_X0_linear)
partial_effect <- E_Y_do_X1 - E_Y_do_X0
cat(sprintf("E[Y|do(X=1)] = %.4f (averaging over Z)\n", E_Y_do_X1))
cat(sprintf("E[Y|do(X=0)] = %.4f (averaging over Z)\n", E_Y_do_X0))
cat(sprintf("PARTIAL intervention effect = %.4f\n\n", partial_effect))
# Compare
cat("--- Comparison ---\n")
cat(sprintf("COMPLETE intervention effect: %.4f\n", complete_effect))
cat(sprintf("PARTIAL intervention effect:  %.4f\n", partial_effect))
cat(sprintf("Conditional β (from model):   %.4f\n", beta_X_full))
cat(sprintf("Marginal β (from model):      %.4f\n", beta_X_partial))
cat(sprintf("True causal parameter:        %.4f\n\n", 2.0))
cat("✓ ALL ARE EQUAL in linear models!\n")
cat("✓ INVARIANCE holds for both complete and partial interventions\n")
cat("  This is special to linear models due to additivity\n\n")
# Effect on descendant W
cat("--- Effect on Descendant W ---\n")
lm_W_full <- lm(W_linear ~ X + Z)
lm_W_partial <- lm(W_linear ~ X)
cat(sprintf("Effect of X on W (full model):    %.4f\n", coef(lm_W_full)["X"]))
cat(sprintf("Effect of X on W (partial model): %.4f\n", coef(lm_W_partial)["X"]))
cat(sprintf("Expected (0.5 * 2.0):             %.4f\n", 0.5 * 2.0))
cat("✓ Effects propagate linearly through the causal chain\n\n")
Z <- rbinom(n, 1, 0.5)
X <- rbinom(n, 1, 0.5)
# Causal mechanism for Y
# Y = 2*X + 3*Z + noise
Y_linear <- 2*X + 3*Z + rnorm(n, 0, 1)
# Full model (complete causes of Y)
lm_full <- lm(Y_linear ~ X + Z)
# Partial model (omitting Z)
lm_partial <- lm(Y_linear ~ X)
summary(lm_full)
summary(lm_partial)
(lm_full$residuals^2)/n
# Full model (complete causes of Y)
lm_full <- lm(Y_linear ~ X + Z)
# Partial model (omitting Z)
lm_partial <- lm(Y_linear ~ X)
summary(lm_full)
summary(lm_partial)
sum(lm_full$residuals^2)/n
sum(lm_partial$residuals^2)/n
